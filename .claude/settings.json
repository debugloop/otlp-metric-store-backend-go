{
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(gofmt *)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(go mod verify)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.go) gofmt -w \"$f\"; out=$(go vet ./... 2>&1) || { echo \"$out\" >&2; exit 2; } ;; esac",
            "timeout": 120,
            "statusMessage": "gofmt + go vet"
          }
        ]
      }
    ]
  }
}
